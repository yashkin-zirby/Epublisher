<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Epublisher.ViewModels"
             x:DataType="vm:ReaderViewModel"
             x:Class="Epublisher.Views.ReaderView"
             Header="{Binding BookTitle}">
    <Grid RowDefinitions="Auto, *, Auto">
        <Border Grid.Row="0"
                Padding="12,8"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
            <Grid ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="10">
                <!-- Toggle Left Chapter Drawer -->
                <Button Grid.Column="0"
                        Command="{Binding ToggleTocDrawerCommand}"
                        Padding="10,6"
                        ToolTip.Tip="{DynamicResource Reader.Contents}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="M3,6H21V8H3V6M3,11H21V13H3V11M3,16H21V18H3V16Z" Width="14" Height="14" />
                        <TextBlock Text="{DynamicResource Reader.Contents}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <TextBlock Grid.Column="1"
                           Text="{Binding BookTitle}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                    <Button Content="A-" Click="OnDecreaseFontClick" Padding="8,6" />
                    <Button Content="A+" Click="OnIncreaseFontClick" Padding="8,6" />
                </StackPanel>

                <Button Grid.Column="3"
                        Command="{Binding EditCurrentBookCommand}"
                        Padding="10,6"
                        ToolTip.Tip="{DynamicResource Home.Edit}">
                    <PathIcon Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"
                              Width="15" Height="15" />
                </Button>
            </Grid>
        </Border>

        <Panel Grid.Row="1">
            <!-- Hide NativeWebView while drawer is open so native HWND/Surface never covers the chapter list -->
            <NativeWebView x:Name="EpubWebView"
                           Source="{Binding ReaderSourceUri}"
                           IsVisible="{Binding !IsTocDrawerOpen}" />

            <!-- Left Chapter Navigation Drawer -->
            <Border Width="280"
                    HorizontalAlignment="Left"
                    Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="0,0,1,0"
                    IsVisible="{Binding IsTocDrawerOpen}"
                    Padding="12">
                <Grid RowDefinitions="Auto, Auto, *">
                    <!-- Drawer Header -->
                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,8">
                        <TextBlock Text="{DynamicResource Reader.Contents}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Content="✕"
                                Command="{Binding ToggleTocDrawerCommand}"
                                Background="Transparent"
                                Padding="6,2" />
                    </Grid>

                    <!-- Quick Jump to Top of Book -->
                    <Button Grid.Row="1"
                            Click="OnScrollToTopClick"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Margin="0,0,0,8"
                            Padding="8,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="M7.41,15.41L12,10.83L16.59,15.41L18,14L12,8L6,14L7.41,15.41Z" Width="13" Height="13" />
                            <TextBlock Text="{DynamicResource Reader.ToTop}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Chapter List -->
                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding Chapters}"
                             SelectedItem="{Binding SelectedChapter, Mode=TwoWay}"
                             SelectionChanged="OnChapterSelectionChanged"
                             Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}"
                                           TextTrimming="CharacterEllipsis"
                                           Padding="4,6" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border IsVisible="{Binding IsLoading}"
                    Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
                <ProgressBar IsIndeterminate="True"
                             Width="200"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
            </Border>
        </Panel>

        <Border Grid.Row="2"
                Padding="12,6"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                <ProgressBar Grid.Column="0"
                             Minimum="0" Maximum="1"
                             Value="{Binding ReadingProgress}"
                             Height="4"
                             VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding ProgressPercentageText}"
                           FontSize="12"
                           Opacity="0.8"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
