<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Epublisher.ViewModels"
             xmlns:models="using:Epublisher.DataEntities"
             xmlns:conv="using:Epublisher.Converters"
             Header="{DynamicResource Home.Title}"
             x:DataType="vm:HomeViewModel"
             x:Class="Epublisher.Views.HomeView">
    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:HomeViewModel />
    </Design.DataContext>
    <Grid RowDefinitions="Auto, *">
        <!-- ВЕРХНЯЯ ПАНЕЛЬ: Поиск, импорт и кнопка настроек -->
        <Border Grid.Row="0"
            Padding="16,12"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
            <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="10">
                <TextBox Grid.Column="0"
                     Text="{Binding SearchQuery, Mode=TwoWay}"
                     PlaceholderText="{DynamicResource Home.SearchPlaceholder}"
                     VerticalContentAlignment="Center" />

                <Button Grid.Column="1"
                    Command="{Binding ImportNewBookCommand}"
                    Classes="accent"
                    Padding="14,8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                       <PathIcon Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" Width="14" Height="14" />
                        <TextBlock Text="{DynamicResource Home.ImportButton}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="2"
                    Name="SettingButton"
                    Click="SettingButton_Click"
                    Padding="12,8">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z"
                              Width="15" Height="15" />
                        <TextBlock Text="{DynamicResource Home.OpenSettings}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
        <Border Grid.Row="0" Grid.RowSpan="2"
            IsVisible="{Binding IsImporting}"
            Background="#AA000000">
            <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                CornerRadius="12"
                Padding="24,20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <StackPanel Spacing="12" HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="220" />
                    <TextBlock Text="{DynamicResource Home.ImportingProgress}"
                       HorizontalAlignment="Center"
                       FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Border>
        <!-- ЗАГЛУШКА, ЕСЛИ КНИГ ЕЩЕ НЕТ -->
        <StackPanel Grid.Row="1"
                    IsVisible="{Binding IsEmpty}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="14"
                    Margin="24">
            <PathIcon Data="M18,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V4A2,2 0 0,0 18,2M6,4H11V12L8.5,10.5L6,12V4Z"
                      Width="56" Height="56"
                      Opacity="0.45" />
            <TextBlock Text="{DynamicResource Home.EmptyTitle}"
                       FontSize="18"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{DynamicResource Home.EmptySubtitle}"
                       Opacity="0.7"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       MaxWidth="320" />
            <Button Command="{Binding ImportNewBookCommand}"
                    Content="{DynamicResource Home.ImportButton}"
                    HorizontalAlignment="Center"
                    Padding="20,10" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" IsVisible="{Binding !IsEmpty}">
            <ItemsControl ItemsSource="{Binding RecentBooks}" Margin="12">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:RecentFile">
                        <Border Width="320"
                                Margin="8"
                                Padding="12"
                                CornerRadius="10"
                                Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                BorderThickness="1">
                            <Grid RowDefinitions="Auto, Auto, Auto" RowSpacing="10">

                                <!-- ВЕРХ КАРТОЧКИ: Обложка + Метаданные -->
                                <Grid Grid.Row="0" ColumnDefinitions="76, *" ColumnSpacing="12">
                                    <!-- Обложка или заглушка -->
                                    <Border Grid.Column="0"
                                        Width="76" Height="110"
                                        CornerRadius="6"
                                        ClipToBounds="True"
                                        Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                                        <Panel>
                                            <PathIcon Data="M18,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V4A2,2 0 0,0 18,2Z"
                                                Width="28" Height="28"
                                                Opacity="0.3" />
                                            <Image Source="{Binding CoverThumbnailPath, Converter={x:Static conv:PathToBitmapConverter.Instance}}"
                                                Stretch="UniformToFill" />
                                        </Panel>
                                    </Border>

                                    <!-- Название, автор, бейджи и кнопка закрепления -->
                                    <Grid Grid.Column="1" RowDefinitions="Auto, Auto, *, Auto">
                                        <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                                            <TextBlock Grid.Column="0"
                                               Text="{Binding Title}"
                                               FontWeight="Bold"
                                               FontSize="15"
                                               MaxLines="2"
                                               TextTrimming="CharacterEllipsis" />

                                            <Button Grid.Column="1"
                                            Command="{Binding $parent[ItemsControl].((vm:HomeViewModel)DataContext).TogglePinCommand}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent"
                                            Padding="4"
                                            ToolTip.Tip="Закрепить">
                                            <PathIcon Data="M16,12V4H17V2H7V4H8V12L6,14V16H11.2V22H12.8V16H18V14L16,12Z"
                                                  Width="14" Height="14"
                                                  Opacity="{Binding IsPinned, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                            </Button>
                                        </Grid>

                                        <TextBlock Grid.Row="1"
                                           Text="{Binding Author}"
                                           FontSize="13"
                                           Opacity="0.75"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,2,0,0" />

                                        <!-- Бейджи: Исходный формат + Статус сохранения -->
                                        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="6">
                                            <Border Background="{DynamicResource SystemControlHighlightAccentBrush}"
                                                CornerRadius="4"
                                                Padding="6,2">
                                                <TextBlock Text="{Binding OriginalFormat}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="White" />
                                            </Border>

                                            <Border IsVisible="{Binding HasUnsavedChanges}"
                                                    Background="#D97706"
                                                    CornerRadius="4"
                                                    Padding="6,2">
                                                <TextBlock Text="Не экспортирован"
                                                   FontSize="11"
                                                   Foreground="White" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Grid>

                                <!-- СЕРЕДИНА: Прогресс чтения -->
                                <ProgressBar Grid.Row="1"
                                     Minimum="0" Maximum="1"
                                     Value="{Binding ReadingProgress}"
                                     Height="4" />

                                <!-- НИЗ КАРТОЧКИ: Действия (Читать, Редактировать, Экспорт, Удалить) -->
                                <Grid Grid.Row="2" ColumnDefinitions="*, *, Auto, Auto" ColumnSpacing="6">
                                    <Button Grid.Column="0"
                                            Command="{Binding $parent[ItemsControl].((vm:HomeViewModel)DataContext).OpenForReadCommand}"
                                            CommandParameter="{Binding}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Content="{DynamicResource Home.Read}" />

                                    <Button Grid.Column="1"
                                            Command="{Binding $parent[ItemsControl].((vm:HomeViewModel)DataContext).OpenForEditCommand}"
                                            CommandParameter="{Binding}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Content="{DynamicResource Home.Edit}" />

                                    <Button Grid.Column="2"
                                            Command="{Binding $parent[ItemsControl].((vm:HomeViewModel)DataContext).ExportBookCommand}"
                                            CommandParameter="{Binding}"
                                            Padding="8"
                                            ToolTip.Tip="Экспортировать в EPUB">
                                        <PathIcon Data="M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z" Width="15" Height="15" />
                                    </Button>

                                    <Button Grid.Column="3"
                                        Command="{Binding $parent[ItemsControl].((vm:HomeViewModel)DataContext).DeleteBookCommand}"
                                        CommandParameter="{Binding}"
                                        Padding="8"
                                        ToolTip.Tip="Удалить">
                                        <PathIcon Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z" Width="15" Height="15" />
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
     </Grid>
</ContentPage>
