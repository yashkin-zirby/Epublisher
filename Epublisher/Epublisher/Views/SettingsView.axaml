<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Epublisher.ViewModels"
             xmlns:models="using:Epublisher.DataEntities"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             Header="Settings"
             x:DataType="vm:SettingsViewModel"
             x:Class="Epublisher.Views.SettingsView">
    <Design.DataContext>
        <vm:HomeViewModel />
    </Design.DataContext>
    <ScrollViewer>
        <StackPanel Margin="20" Spacing="15">
            <TextBlock Text="{DynamicResource Settings.Title}" FontSize="20" FontWeight="Bold"/>
            
            <TextBlock Text="{DynamicResource Settings.Language}"/>
            <ComboBox ItemsSource="{Binding LanguagesList}"
                      SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                      DisplayMemberBinding="{Binding Value}"
                      HorizontalAlignment="Stretch"/>

            <TextBlock Text="{DynamicResource Settings.Theme}"/>
            <ComboBox ItemsSource="{Binding ThemesList}"
                      SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                      DisplayMemberBinding="{Binding Value}"
                      HorizontalAlignment="Stretch"/>

            <Expander Header="{DynamicResource Settings.Logging}"
                      HorizontalAlignment="Stretch"
                      IsExpanded="False">
                <StackPanel Spacing="10" Margin="5">
                    
                    <CheckBox Content="{DynamicResource Settings.Logging.AllowLog}"
                              IsChecked="{Binding AllowLog, Mode=TwoWay}" />

                    <StackPanel Spacing="8" Margin="20,0,0,0" IsEnabled="{Binding AllowLog}">
                        <CheckBox Content="{DynamicResource Settings.Logging.AllowDebug}"
                                  IsChecked="{Binding AllowLogDebug, Mode=TwoWay}" />
                        
                        <CheckBox Content="{DynamicResource Settings.Logging.AllowWarning}"
                                  IsChecked="{Binding AllowLogWarning, Mode=TwoWay}" />
                        
                        <CheckBox Content="{DynamicResource Settings.Logging.AllowError}"
                                  IsChecked="{Binding AllowLogError, Mode=TwoWay}" />
                    </StackPanel>

                    <Separator Margin="0,5" />

                    <CheckBox Content="{DynamicResource Settings.Logging.AllowMessageBox}"
                              IsChecked="{Binding AllowMessageBox, Mode=TwoWay}" />

                    <CheckBox Content="{DynamicResource Settings.Logging.AllowMessageBoxOnlyErrors}"
                              IsChecked="{Binding AllowMessageBoxOnlyErrors, Mode=TwoWay}"
                              IsEnabled="{Binding AllowMessageBox}"
                              Margin="20,0,0,0" />
                </StackPanel>
            </Expander>
            <!-- CUSTOM HTML RULES CARD -->
<Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
        CornerRadius="8"
        Padding="16"
        Margin="0,0,0,16">
    <StackPanel Spacing="12">
        <TextBlock Text="{DynamicResource Settings.CustomHtmlSectionTitle}"
                   FontSize="16"
                   FontWeight="Bold" />

        <!-- Add new HTML Rule form -->
        <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto, Auto" ColumnSpacing="8" RowSpacing="8">
            <TextBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                     Text="{Binding NewHtmlRuleName, Mode=TwoWay}"
                     Watermark="{DynamicResource Settings.RuleNamePlaceholder}" />

            <TextBox Grid.Row="1" Grid.Column="0"
                     Text="{Binding NewHtmlOpenTag, Mode=TwoWay}"
                     Watermark="{DynamicResource Settings.OpenTagPlaceholder}"
                     FontFamily="Consolas, Monospace" />

            <TextBox Grid.Row="1" Grid.Column="1"
                     Text="{Binding NewHtmlCloseTag, Mode=TwoWay}"
                     Watermark="{DynamicResource Settings.CloseTagPlaceholder}"
                     FontFamily="Consolas, Monospace" />

            <TextBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                     Text="{Binding NewHtmlAssociatedCss, Mode=TwoWay}"
                     Watermark="{DynamicResource Settings.AssociatedCssPlaceholder}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MinHeight="60"
                     FontFamily="Consolas, Monospace" />
        </Grid>

        <Button Command="{Binding AddHtmlRuleCommand}"
                Content="{DynamicResource Settings.AddRuleButton}"
                Classes="accent"
                HorizontalAlignment="Right"
                Padding="12,6" />

        <!-- Existing HTML Rules list -->
        <ItemsControl ItemsSource="{Binding HtmlRules}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:CustomHtmlRule">
                    <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10"
                            Margin="0,0,0,6">
                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding OpenTag}"
                                               FontFamily="Consolas, Monospace"
                                               FontSize="12"
                                               Opacity="0.8" />
                                    <TextBlock Text="…"
                                               IsVisible="{Binding CloseTag, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                               Opacity="0.6" />
                                    <TextBlock Text="{Binding CloseTag}"
                                               FontFamily="Consolas, Monospace"
                                               FontSize="12"
                                               Opacity="0.8" />
                                </StackPanel>
                                <TextBlock Text="{Binding AssociatedCss}"
                                           IsVisible="{Binding AssociatedCss, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                           FontFamily="Consolas, Monospace"
                                           FontSize="11"
                                           Opacity="0.6"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Content="×"
                                    VerticalAlignment="Center"
                                    Padding="8,4"
                                    Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).DeleteHtmlRuleCommand}"
                                    CommandParameter="{Binding}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</Border>

<!-- CUSTOM CSS TEMPLATES CARD -->
<Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
        CornerRadius="8"
        Padding="16"
        Margin="0,0,0,16">
    <StackPanel Spacing="12">
        <TextBlock Text="{DynamicResource Settings.CustomCssSectionTitle}"
                   FontSize="16"
                   FontWeight="Bold" />

        <!-- Add new CSS Template form -->
        <StackPanel Spacing="8">
            <TextBox Text="{Binding NewCssTemplateName, Mode=TwoWay}"
                     Watermark="{DynamicResource Settings.TemplateNamePlaceholder}" />

            <TextBox Text="{Binding NewCssTemplateCode, Mode=TwoWay}"
                     Watermark="{DynamicResource Settings.CssCodePlaceholder}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MinHeight="72"
                     FontFamily="Consolas, Monospace" />
        </StackPanel>

        <Button Command="{Binding AddCssTemplateCommand}"
                Content="{DynamicResource Settings.AddTemplateButton}"
                Classes="accent"
                HorizontalAlignment="Right"
                Padding="12,6" />

        <!-- Existing CSS Templates list -->
        <ItemsControl ItemsSource="{Binding CssTemplates}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:CustomCssTemplate">
                    <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10"
                            Margin="0,0,0,6">
                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding CssCode}"
                                           FontFamily="Consolas, Monospace"
                                           FontSize="11"
                                           Opacity="0.7"
                                           MaxLines="2"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Content="×"
                                    VerticalAlignment="Center"
                                    Padding="8,4"
                                    Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).DeleteCssTemplateCommand}"
                                    CommandParameter="{Binding}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</Border>
        </StackPanel>
    </ScrollViewer>
</ContentPage>
